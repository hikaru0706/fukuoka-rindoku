{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://fukuoka-tsudoi.web.app/rindoku/",
        "type": 301
      },
      {
        "source": "/:path*",
        "destination": "https://fukuoka-tsudoi.web.app/rindoku/:path",
        "type": 301
      }
    ]
  }
}
